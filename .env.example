# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# FIREBASE_API_KEY: Optional Firebase Web API Key for authentication and cloud services.
# Configure this securely via the Secrets panel in the AI Studio UI.
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY

# TMDB_API_KEY: TMDB v3 API Key for fetching real movie/series cast members and poster URLs.
# Configure this securely via the Secrets panel in the AI Studio UI.
TMDB_API_KEY=YOUR_TMDB_API_KEY

# HARAKAPAY_API_KEY: HarakaPay API Key for TZS USSD Push payment collection and status verification.
# Configure this securely via the Secrets panel in the AI Studio UI.
HARAKAPAY_API_KEY=YOUR_HARAKAPAY_API_KEY



