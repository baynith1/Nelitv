# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# FIREBASE_API_KEY: Optional Firebase Web API Key for authentication and cloud services.
# Configure this securely via the Secrets panel in the AI Studio UI.
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY

# TMDB_API_KEY: TMDB v3 API Key for fetching real movie/series cast members and poster URLs.
# Configure this securely via the Secrets panel in the AI Studio UI.
TMDB_API_KEY=YOUR_TMDB_API_KEY

# HARAKAPAY_API_KEY: HarakaPay API Key for TZS USSD Push payment collection and status verification.
# Configure this securely via the Secrets panel in the AI Studio UI.
HARAKAPAY_API_KEY=YOUR_HARAKAPAY_API_KEY

# CAST_RECEIVER_BASE_URL: Base URL for the Scan to Cast Web Receiver (e.g. Firebase Hosting URL).
# The Android app constructs: CAST_RECEIVER_BASE_URL + "/cast/" + sessionId
CAST_RECEIVER_BASE_URL=https://cast-nelitv.web.app

# NELITV_API_KEY: API Key for NeliTv App Server (https://nelitv.online/api/v1/* and /baynithalex/api/*).
# Configure this securely via the Secrets panel in the AI Studio UI.
NELITV_API_KEY=YOUR_NELITV_API_KEY

# NELI_AI_API_KEY: API Key for Neli AI Center (POST https://nelitv.online/v1/neli-ai/command via X-API-Key).
# Configure this securely via the Secrets panel in the AI Studio UI.
NELI_AI_API_KEY=YOUR_NELI_AI_API_KEY

# YouTube video ID resolution for existing in-app YouTube movies runs via the
# nelitv.online backend proxy (/api/v1/youtube/video?id=...) using server-side
# YOUTUBE_API_KEY so no YouTube API key is ever bundled inside the APK.
